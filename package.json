{
  "name": "dsh-web-preview",
  "version": "1.1.0",
  "description": "Preview any local web server inside the DeepSeek Harness GUI — remote-browser-safe same-origin proxy with an embedded tab, floating window, and a Console/Network/Errors diagnostic toolbox. Works from any DSH origin (https + reverse proxy) without mixed-content or localhost pitfalls.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["dsh", "dsh-plugin", "browser", "web-preview", "iframe", "proxy", "devtools", "local-server"],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "react": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
